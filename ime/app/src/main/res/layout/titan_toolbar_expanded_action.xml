<?xml version="1.0" encoding="utf-8"?>
<GridLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:columnCount="5"
    android:rowCount="3">

    <TextView
        android:id="@+id/titan_toolbar_copy"
        android:layout_width="@dimen/titan_toolbar_grid_cell_size"
        android:layout_height="@dimen/titan_toolbar_grid_cell_size"
        android:layout_row="0"
        android:layout_column="0"
        android:layout_margin="@dimen/titan_toolbar_button_margin"
        android:background="@drawable/titan_toolbar_button_bg"
        android:contentDescription="@string/titan_toolbar_action_copy"
        android:gravity="center"
        android:text="⎘"
        android:textColor="@android:color/white"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/titan_toolbar_paste"
        android:layout_width="@dimen/titan_toolbar_grid_cell_size"
        android:layout_height="@dimen/titan_toolbar_grid_cell_size"
        android:layout_row="1"
        android:layout_column="0"
        android:layout_margin="@dimen/titan_toolbar_button_margin"
        android:background="@drawable/titan_toolbar_button_bg"
        android:contentDescription="@string/titan_toolbar_action_paste"
        android:gravity="center"
        android:text="⎗"
        android:textColor="@android:color/white"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/titan_toolbar_left"
        android:layout_width="@dimen/titan_toolbar_grid_cell_size"
        android:layout_height="0dp"
        android:layout_row="0"
        android:layout_rowSpan="3"
        android:layout_column="1"
        android:layout_margin="@dimen/titan_toolbar_button_margin"
        android:layout_gravity="fill"
        android:background="@drawable/titan_toolbar_button_bg"
        android:contentDescription="@string/titan_toolbar_action_left"
        android:gravity="center"
        android:text="‹"
        android:textColor="@android:color/white"
        android:textSize="28sp" />

    <TextView
        android:id="@+id/titan_toolbar_up"
        android:layout_width="@dimen/titan_toolbar_grid_cell_size"
        android:layout_height="@dimen/titan_toolbar_grid_cell_size"
        android:layout_row="0"
        android:layout_column="2"
        android:layout_margin="@dimen/titan_toolbar_button_margin"
        android:background="@drawable/titan_toolbar_button_bg"
        android:contentDescription="@string/titan_toolbar_action_up"
        android:gravity="center"
        android:text="∧"
        android:textColor="@android:color/white"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/titan_toolbar_dpad"
        android:layout_width="@dimen/titan_toolbar_grid_cell_size"
        android:layout_height="@dimen/titan_toolbar_grid_cell_size"
        android:layout_row="1"
        android:layout_column="2"
        android:layout_margin="@dimen/titan_toolbar_button_margin"
        android:background="@drawable/titan_toolbar_button_bg"
        android:contentDescription="@string/titan_toolbar_action_dpad"
        android:gravity="center"
        android:text="⌖"
        android:textColor="@android:color/white"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/titan_toolbar_down"
        android:layout_width="@dimen/titan_toolbar_grid_cell_size"
        android:layout_height="@dimen/titan_toolbar_grid_cell_size"
        android:layout_row="2"
        android:layout_column="2"
        android:layout_margin="@dimen/titan_toolbar_button_margin"
        android:background="@drawable/titan_toolbar_button_bg"
        android:contentDescription="@string/titan_toolbar_action_down"
        android:gravity="center"
        android:text="∨"
        android:textColor="@android:color/white"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/titan_toolbar_right"
        android:layout_width="@dimen/titan_toolbar_grid_cell_size"
        android:layout_height="0dp"
        android:layout_row="0"
        android:layout_rowSpan="3"
        android:layout_column="3"
        android:layout_margin="@dimen/titan_toolbar_button_margin"
        android:layout_gravity="fill"
        android:background="@drawable/titan_toolbar_button_bg"
        android:contentDescription="@string/titan_toolbar_action_right"
        android:gravity="center"
        android:text="›"
        android:textColor="@android:color/white"
        android:textSize="28sp" />

    <TextView
        android:id="@+id/titan_toolbar_select_all"
        android:layout_width="@dimen/titan_toolbar_grid_cell_size"
        android:layout_height="@dimen/titan_toolbar_grid_cell_size"
        android:layout_row="0"
        android:layout_column="4"
        android:layout_margin="@dimen/titan_toolbar_button_margin"
        android:background="@drawable/titan_toolbar_button_bg"
        android:contentDescription="@string/titan_toolbar_action_select_all"
        android:gravity="center"
        android:text="▣"
        android:textColor="@android:color/white"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/titan_toolbar_delete"
        android:layout_width="@dimen/titan_toolbar_grid_cell_size"
        android:layout_height="@dimen/titan_toolbar_grid_cell_size"
        android:layout_row="1"
        android:layout_column="4"
        android:layout_margin="@dimen/titan_toolbar_button_margin"
        android:background="@drawable/titan_toolbar_button_bg"
        android:contentDescription="@string/titan_toolbar_action_delete"
        android:gravity="center"
        android:text="⌫"
        android:textColor="@android:color/white"
        android:textSize="16sp" />
</GridLayout>
