<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="@dimen/candidate_strip_height"
    android:orientation="horizontal"
    android:gravity="center_vertical">

    <TextView
        android:id="@+id/nav_action_home"
        android:layout_width="@dimen/candidate_strip_height"
        android:layout_height="@dimen/candidate_strip_height"
        android:background="@android:color/transparent"
        android:contentDescription="@string/nav_action_home"
        android:gravity="center"
        android:text="⇤"
        android:textColor="@android:color/white"
        android:textSize="18sp" />

    <ImageView
        android:id="@+id/nav_action_left"
        android:layout_width="@dimen/candidate_strip_height"
        android:layout_height="@dimen/candidate_strip_height"
        android:background="@android:color/transparent"
        android:contentDescription="@string/nav_action_left"
        android:scaleType="centerInside"
        android:src="@drawable/yochees_dark_arrow_left" />

    <ImageView
        android:id="@+id/nav_action_right"
        android:layout_width="@dimen/candidate_strip_height"
        android:layout_height="@dimen/candidate_strip_height"
        android:background="@android:color/transparent"
        android:contentDescription="@string/nav_action_right"
        android:scaleType="centerInside"
        android:src="@drawable/yochees_dark_arrow_right" />

    <TextView
        android:id="@+id/nav_action_end"
        android:layout_width="@dimen/candidate_strip_height"
        android:layout_height="@dimen/candidate_strip_height"
        android:background="@android:color/transparent"
        android:contentDescription="@string/nav_action_end"
        android:gravity="center"
        android:text="⇥"
        android:textColor="@android:color/white"
        android:textSize="18sp" />
</LinearLayout>